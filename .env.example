# Examples only. Spring Boot does not automatically load this file.
# Export backend variables in your shell or set them in your hosting dashboard.
# Put VITE_API_BASE_URL in frontend/.env.local if you want the optional API.

# Empty API URL uses saved JSON data. VITE_* values are public in builds.
VITE_API_BASE_URL=
# By default the app checks the public repository for newer saved instructor data.
# Set VITE_CATALOG_BASE_URL= in frontend/.env.local for bundled-only/offline use.
# VITE_CATALOG_BASE_URL=https://raw.githubusercontent.com/leo205/osuProfs/main/frontend/public

# Backend defaults when started from the backend/ directory.
PORT=8080
SPRING_PROFILES_ACTIVE=local
APP_CATALOG_PATH=../frontend/public/data/catalog-index.json
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173

# Optional importer/discovery settings; enable only for a non-web CLI import.
# The README shows the complete java -jar command. Paths here assume backend/ cwd.
# APP_IMPORT_ENABLED=true
# APP_IMPORT_OUTPUT=../artifacts/catalog.json
# APP_DISCOVERY_ENABLED=true
# APP_DISCOVERY_SUBJECT=ALL
# APP_DISCOVERY_CANDIDATE_SUBJECT=CSE
# APP_DISCOVERY_CANDIDATE_FILE=../data/discovery/cse-surnames.txt
# APP_DISCOVERY_IDENTITY_FILE=../data/discovery/cse-instructor-identities.json
# APP_DISCOVERY_INCLUDE_CATALOG_CANDIDATES=true
# APP_DISCOVERY_MAX_CANDIDATES=200
# APP_DISCOVERY_HISTORY_FILE=../artifacts/university/history.json

# Optional PostgreSQL profile only; keep actual credentials out of version control.
# SPRING_PROFILES_ACTIVE=postgres
# DATABASE_URL=jdbc:postgresql://localhost:5432/osuprofs
# DATABASE_USERNAME=osuprofs
# DATABASE_PASSWORD=replace-with-your-local-password

# Configure Cloudflare credentials as GitHub Actions secrets, never VITE_* vars:
# CLOUDFLARE_ACCOUNT_ID
# CLOUDFLARE_API_TOKEN
# CLOUDFLARE_PROJECT_NAME
# Optional Actions variables: PAUSE_CATALOG_REFRESH, ENABLE_CLOUDFLARE_DEPLOY,
# VITE_API_BASE_URL. See docs/deployment.md before enabling publication.
